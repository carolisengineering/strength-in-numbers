    "/v1/muscle-groups": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "muscleGroups": {
                      "type": "array",
                      "items": {
