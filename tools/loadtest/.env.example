# Spec 16 Phase B — copy to tools/loadtest/.env.loadtest (gitignored) and fill in. Runbook: docs/runbooks/load-testing.md.
# Never commit the filled-in file, never paste its values anywhere, and rotate the password after sharing it.

# Runs against staging / prod (the load-test application and its database connection)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
LOADTEST_AUTH0_CLIENT_ID=
LOADTEST_AUTH0_CLIENT_SECRET=
LOADTEST_AUTH0_CONNECTION=
LOADTEST_ACCOUNT_PASSWORD=

# setup-accounts only (Management API application: read:users and create:users)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# k6 metrics to Grafana Cloud (Prometheus remote-write; metrics-write token)
GRAFANA_PROM_RW_URL=
GRAFANA_PROM_RW_USER=
GRAFANA_PROM_RW_TOKEN=

# Run annotations (Grafana service-account token limited to annotations)
GRAFANA_URL=
GRAFANA_ANNOTATION_TOKEN=
