    "test:integration": "pnpm -r test:integration",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "core:purity": "pnpm --filter @sin/core purity"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
