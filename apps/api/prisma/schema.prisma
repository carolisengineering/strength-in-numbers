// Spec 01 §4 owns `user`; Spec 03.1 §4 adds `exercise` / `muscle_group` /
// `equipment`. The migration SQL is hand-authored — the partial unique index on
// `exercise.catalog_key` (WHERE owner_user_id IS NULL) and the `modality` CHECK
// are not expressible here, so these models carry the client shape only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @db.Uuid // app-generated UUIDv7 (Spec 01 Q5)
  authSub        String    @unique(map: "user_auth_sub_key") @map("auth_sub")
  email          String // NOT unique on purpose — auth_sub is the only stable key
  emailVerified  Boolean   @default(false) @map("email_verified")
  displayName    String?   @map("display_name")
  unitPreference String    @default("kg") @map("unit_preference") // CHECK ('kg','lb') added in migration
  timezone       String    @default("UTC") // IANA name
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Spec 03.1: back-reference for `exercise.owner_user_id` (Prisma requires both
  // sides of a relation). No column on `user`; purge cascades via the FK.
  customExercises Exercise[]
  // Spec 05.0: back-reference for `workout.user_id`.
  workouts Workout[]
  // Spec 07.0: back-reference for `personal_record.user_id`.
  personalRecords PersonalRecord[]
  // Spec 09: back-reference for `routine.user_id`.
  routines Routine[]
  // Spec 19.0: back-references for the hevy_ tables (all cascade from user).
  hevyPairs        HevyExercisePair[]
  hevySectionRules HevySectionRule[]
  hevyLinks        HevyLink[]
  hevyAccount      HevyAccount?

  @@index([email], map: "user_email_idx")
  @@map("user")
}

// Spec 03.1 §4 — exercise catalog. Curated rows have `ownerUserId = null` and a
// unique `catalogKey`; custom rows (Spec 03.2) set `ownerUserId` and leave
// `catalogKey` null. `isActive = false` rows are tombstones returned only in a
// sync delta (Spec 03.3; `?since=`).
model Exercise {
  id                 String       @id @db.Uuid // app-generated UUIDv7
  catalogKey         String?      @map("catalog_key") // kebab-case; null for custom rows
  ownerUserId        String?      @map("owner_user_id") @db.Uuid // null = global/curated
  owner              User?        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name               String
  modality           String // CHECK: weight_reps, bodyweight_reps, weighted_bodyweight, duration, distance_duration, calories, weight_distance, weight_duration (0015)
  primaryMuscleId    String?      @map("primary_muscle_id")
  primaryMuscle      MuscleGroup? @relation(fields: [primaryMuscleId], references: [id], onDelete: Restrict)
  secondaryMuscleIds String[]     @default([]) @map("secondary_muscle_ids") // muscle_group ids, authoring order
  equipmentId        String?      @map("equipment_id")
  equipment          Equipment?   @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  isActive           Boolean      @default(true) @map("is_active")
  // Spec 03.2 §4 — copy-on-write fork provenance. Always points at a global row
  // (owner_user_id IS NULL) in practice; enforced at the application layer, not
  // the DB, since forking never chains (§6).
  forkedFromExerciseId String?    @map("forked_from_exercise_id") @db.Uuid
  forkedFrom         Exercise?    @relation("ExerciseFork", fields: [forkedFromExerciseId], references: [id], onDelete: Restrict)
  forks              Exercise[]   @relation("ExerciseFork")
  // Spec 05.0: back-reference for `workout_exercise.exercise_id`.
  workoutExercises   WorkoutExercise[]
  // Spec 07.0: back-reference for `personal_record.exercise_id` (a lineage root).
  personalRecords    PersonalRecord[]
  // Spec 09: back-reference for `routine_item.exercise_id`.
  routineItems       RoutineItem[]
  // Spec 19.0: back-reference for `hevy_exercise_pair.exercise_id`.
  hevyPairs          HevyExercisePair[]
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Spec 03.3 §4 — commit-ordered sync stamp, set by the exercise_change_xid trigger.
  // Prisma omits Unsupported fields from its typed client; every write here is raw SQL.
  changeXid          Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("change_xid")

  @@index([ownerUserId], map: "exercise_owner_idx")
  @@index([updatedAt], map: "exercise_updated_at_idx")
  @@index([changeXid], map: "exercise_change_xid_idx")
  @@map("exercise")
}

// Reference table — natural-code PK (`chest`, `lats`). Seed-only; codes are
// immutable once shipped (Spec 03.1 D3 / §6.3).
model MuscleGroup {
  id           String     @id // natural code
  name         String
  displayOrder Int        @default(0) @map("display_order") @db.SmallInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  exercises    Exercise[]

  @@map("muscle_group")
}

// Reference table — natural-code PK (`barbell`, `dumbbell`). Seed-only; immutable.
model Equipment {
  id           String     @id // natural code
  name         String
  displayOrder Int        @default(0) @map("display_order") @db.SmallInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  exercises    Exercise[]

  @@map("equipment")
}

// Spec 05.0 §4 — workout session lifecycle. Hand-authored SQL owns the
// partial unique index, the two CHECKs and the deferrable constraint; these
// models carry the client shape only.
model Workout {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String?
  notes              String?
  startedAt          DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(6)
  localDate          DateTime  @map("local_date") @db.Date
  tzOffsetMinutes    Int       @map("tz_offset_minutes") @db.SmallInt
  clientGeneratedId  String    @map("client_generated_id") @db.Uuid
  source             String    @default("manual") // CHECK: manual, hevy (0016)
  // Spec 09 §4: set at start-from-routine; the FK is ON DELETE SET NULL, the snapshot survives.
  routineId           String?   @map("routine_id") @db.Uuid
  routine             Routine?  @relation(fields: [routineId], references: [id], onDelete: SetNull)
  routineNameSnapshot String?   @map("routine_name_snapshot")
  routineNotesSnapshot String?  @map("routine_notes_snapshot")
  // Spec 07.4 §4: a live workout's planned "took"; the CHECKs (0..86400, live-only) are in 0012's SQL.
  plannedDurationS    Int?      @map("planned_duration_s")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  exercises          WorkoutExercise[]
  sections           WorkoutSection[]
  // Spec 07.0: back-reference for `personal_record.workout_id`.
  personalRecords    PersonalRecord[]
  // Spec 19.0: back-reference for `hevy_link.workout_id` (SET NULL: a deleted workout leaves a tombstone).
  hevyLinks          HevyLink[]

  @@unique([userId, clientGeneratedId], map: "workout_user_client_id_key")
  @@index([userId, startedAt(sort: Desc)], map: "workout_user_started_idx")
  @@map("workout")
}

model WorkoutExercise {
  id                   String   @id @db.Uuid
  workoutId            String   @map("workout_id") @db.Uuid
  workout              Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  position             Int      @db.SmallInt
  exerciseId           String   @map("exercise_id") @db.Uuid
  exercise             Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseNameSnapshot String   @map("exercise_name_snapshot")
  modalitySnapshot     String   @map("modality_snapshot")
  notes                String?
  // Spec 09 §4: target snapshots copied from the routine item (D1) and the live superset group (D10).
  supersetGroup        Int?     @map("superset_group") @db.SmallInt
  targetSets           Int?     @map("target_sets") @db.SmallInt
  targetRepsLow        Int?     @map("target_reps_low") @db.SmallInt
  targetRepsHigh       Int?     @map("target_reps_high") @db.SmallInt
  targetRpe            Int?     @map("target_rpe") @db.SmallInt
  restSeconds          Int?     @map("rest_seconds") @db.SmallInt
  sectionId            String?  @map("section_id") @db.Uuid
  section              WorkoutSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull, map: "workout_exercise_section_fkey")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  sets                 SetEntry[]
  plannedSets          WorkoutPlannedSet[]

  @@unique([workoutId, position], map: "workout_exercise_position_key")
  @@index([exerciseId], map: "workout_exercise_exercise_idx")
  @@map("workout_exercise")
}

// Spec 09 §4 — hand-authored migration 0009 carries the CHECKs, the
// (user_id, lower(name)) expression index and ON DELETE SET NULL; these
// models are the client shape only (every repository write is raw SQL).
model Routine {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// Spec 09.3 — the one-off mark and its expiry; NULL = ordinary. CHECK (> created_at) is in 0013.
  oneOffUntil DateTime? @map("one_off_until") @db.Timestamptz(6)
  items     RoutineItem[]
  sections  RoutineSection[]
  workouts  Workout[]

  @@map("routine")
}

model RoutineItem {
  id             String   @id @db.Uuid
  routineId      String   @map("routine_id") @db.Uuid
  routine        Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  position       Int      @db.SmallInt
  exerciseId     String   @map("exercise_id") @db.Uuid
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  targetSets     Int?     @map("target_sets") @db.SmallInt
  targetRepsLow  Int?     @map("target_reps_low") @db.SmallInt
  targetRepsHigh Int?     @map("target_reps_high") @db.SmallInt
  targetRpe      Int?     @map("target_rpe") @db.SmallInt // tenths (D5)
  restSeconds    Int?     @map("rest_seconds") @db.SmallInt
  supersetGroup  Int?     @map("superset_group") @db.SmallInt
  notes          String?
  sectionId      String?  @map("section_id") @db.Uuid
  section        RoutineSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull, map: "routine_item_section_fkey")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  sets           RoutineItemSet[]

  @@unique([routineId, position], map: "routine_item_routine_position_key")
  @@index([exerciseId], map: "routine_item_exercise_idx")
  @@map("routine_item")
}

// Spec 09.1 §4 — hand-authored migration 0010 carries the CHECKs.
model RoutineItemSet {
  id            String      @id @db.Uuid
  routineItemId String      @map("routine_item_id") @db.Uuid
  routineItem   RoutineItem @relation(fields: [routineItemId], references: [id], onDelete: Cascade, map: "routine_item_set_item_fkey")
  position      Int         @db.SmallInt
  setType       String      @default("working") @map("set_type")
  repsLow       Int?        @map("reps_low") @db.SmallInt
  repsHigh      Int?        @map("reps_high") @db.SmallInt
  weight        Decimal?    @db.Decimal(7, 3)
  weightUnit    String?     @map("weight_unit")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([routineItemId, position], map: "routine_item_set_item_position_key")
  @@map("routine_item_set")
}

model WorkoutPlannedSet {
  id                String          @id @db.Uuid
  workoutExerciseId String          @map("workout_exercise_id") @db.Uuid
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade, map: "workout_planned_set_exercise_fkey")
  position          Int             @db.SmallInt
  setType           String          @default("working") @map("set_type")
  repsLow           Int?            @map("reps_low") @db.SmallInt
  repsHigh          Int?            @map("reps_high") @db.SmallInt
  weight            Decimal?        @db.Decimal(7, 3)
  weightUnit        String?         @map("weight_unit")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([workoutExerciseId, position], map: "workout_planned_set_exercise_position_key")
  @@map("workout_planned_set")
}

model SetEntry {
  id                String          @id @db.Uuid
  workoutExerciseId String          @map("workout_exercise_id") @db.Uuid
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int             @map("set_number") @db.SmallInt
  setType           String          @default("working") @map("set_type")
  reps              Int?            @db.SmallInt
  weight            Decimal?        @db.Decimal(7, 3)
  weightUnit        String?         @map("weight_unit")
  /// GENERATED ALWAYS AS ... STORED (0006). Read-only by convention; never written by the app.
  weightKg          Decimal?        @map("weight_kg") @db.Decimal(7, 3)
  distance          Decimal?        @db.Decimal(9, 3)
  distanceUnit      String?         @map("distance_unit") // CHECK: m, km, mi, ft (0015)
  /// GENERATED ALWAYS AS ... STORED (0006; rebuilt with an ft arm in 0015). Read-only by convention; never written by the app.
  distanceM         Decimal?        @map("distance_m") @db.Decimal(9, 3)
  durationS         Int?            @map("duration_s")
  calories          Int?            @db.SmallInt // Spec 05.3: a count, no unit; CHECK >= 0
  rpe               Decimal?        @db.Decimal(3, 1)
  isComplete        Boolean         @default(false) @map("is_complete")
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// Optional create idempotency key (0007); NULL when the create sent none.
  clientGeneratedId String?         @map("client_generated_id") @db.Uuid
  // Spec 07.0: back-reference for `personal_record.source_set_entry_id`.
  personalRecords   PersonalRecord[]

  @@unique([workoutExerciseId, setNumber], map: "set_entry_workout_exercise_number_key")
  @@unique([workoutExerciseId, clientGeneratedId], map: "set_entry_workout_exercise_client_id_key")
  @@map("set_entry")
}

// Spec 07.0 §4 — a rebuildable cache of personal records. `exerciseId` is the
// LINEAGE ROOT (COALESCE(forked_from_exercise_id, id)), not necessarily the
// exercise logged. CHECKs live in the hand-authored migration (drift-guarded).
model PersonalRecord {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId       String    @map("exercise_id") @db.Uuid
  exercise         Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  recordType       String    @map("record_type")
  value            Decimal   @db.Decimal(14, 3)
  unit             String
  previousValue    Decimal?  @map("previous_value") @db.Decimal(14, 3)
  sourceSetEntryId String    @map("source_set_entry_id") @db.Uuid
  sourceSetEntry   SetEntry  @relation(fields: [sourceSetEntryId], references: [id], onDelete: Cascade)
  workoutId        String    @map("workout_id") @db.Uuid
  workout          Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  achievedAt       DateTime  @map("achieved_at") @db.Timestamptz(6)
  localDate        DateTime  @map("local_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, exerciseId, recordType], map: "personal_record_user_exercise_type_key")
  @@index([workoutId], map: "personal_record_workout_idx")
  @@index([sourceSetEntryId], map: "personal_record_source_set_idx")
  @@map("personal_record")
}

// Spec 09.2 §4 — hand-authored migration 0011 carries the CHECKs and the partial section_id indexes
// (Prisma ignores partial indexes, like workout_routine_idx); these models are the client shape only.
model RoutineSection {
  id        String        @id @db.Uuid
  routineId String        @map("routine_id") @db.Uuid
  routine   Routine       @relation(fields: [routineId], references: [id], onDelete: Cascade, map: "routine_section_routine_fkey")
  position  Int           @db.SmallInt
  name      String
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  items     RoutineItem[]

  @@unique([routineId, position], map: "routine_section_routine_position_key")
  @@map("routine_section")
}

model WorkoutSection {
  id        String            @id @db.Uuid
  workoutId String            @map("workout_id") @db.Uuid
  workout   Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade, map: "workout_section_workout_fkey")
  position  Int               @db.SmallInt
  name      String
  notes     String?
  /// Spec 09.4 — origin: true iff created by POST /v1/workouts/{id}/sections (copied from the routine = false).
  addedInWorkout Boolean    @default(false) @map("added_in_workout")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  exercises WorkoutExercise[]

  @@unique([workoutId, position], map: "workout_section_workout_position_key")
  @@map("workout_section")
}

// Spec 19.0 §4 (0016): the Hevy mapping and links. The migration SQL is hand-authored and the source of truth: the
// CHECK lists, and the partial unique indexes (export_as, placeholders, Hevy id, workout), are SQL-only. Every
// statement on these tables is raw SQL.
model HevyExercisePair {
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "hevy_exercise_pair_user_fkey")
  hevyTemplateId String    @map("hevy_template_id")
  hevyTitle      String    @map("hevy_title")
  hevyType       String?   @map("hevy_type") // NULL only on a skip of an unsupported Hevy template (D19)
  role           String    @default("exercise")
  exerciseId     String?   @map("exercise_id") @db.Uuid
  exercise       Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade, map: "hevy_exercise_pair_exercise_fkey")
  measureRule    String?   @map("measure_rule")
  exportAs       Boolean   @default(false) @map("export_as")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([userId, hevyTemplateId], map: "hevy_exercise_pair_pkey")
  @@index([exerciseId], map: "hevy_exercise_pair_exercise_idx")
  @@map("hevy_exercise_pair")
}

model HevySectionRule {
  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "hevy_section_rule_user_fkey")
  nameKey   String @map("name_key") // lower(trim(name))
  name      String
  treatment String

  @@id([userId, nameKey], map: "hevy_section_rule_pkey")
  @@map("hevy_section_rule")
}

model HevyLink {
  id                String    @id(map: "hevy_link_pkey") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "hevy_link_user_fkey")
  workoutId         String?   @map("workout_id") @db.Uuid // NULL = tombstone
  workout           Workout?  @relation(fields: [workoutId], references: [id], onDelete: SetNull, map: "hevy_link_workout_fkey")
  hevyWorkoutId     String?   @map("hevy_workout_id") // NULL while only a claim
  origin            String
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz(6)
  claimFingerprint  String?   @map("claim_fingerprint") // Spec 19.0 D29: the begin's fingerprint, while a claim is held
  syncedFingerprint String?   @map("synced_fingerprint")
  syncedAt          DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("hevy_link")
}

model HevyAccount {
  userId       String   @id(map: "hevy_account_pkey") @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "hevy_account_user_fkey")
  recordsStale Boolean  @default(false) @map("records_stale")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("hevy_account")
}
