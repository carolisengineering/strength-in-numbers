// Spec 01 §4 owns `user`; Spec 03.1 §4 adds `exercise` / `muscle_group` /
// `equipment`. The migration SQL is hand-authored — the partial unique index on
// `exercise.catalog_key` (WHERE owner_user_id IS NULL) and the `modality` CHECK
// are not expressible here, so these models carry the client shape only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @db.Uuid // app-generated UUIDv7 (Spec 01 Q5)
  authSub        String    @unique(map: "user_auth_sub_key") @map("auth_sub")
  email          String // NOT unique on purpose — auth_sub is the only stable key
  emailVerified  Boolean   @default(false) @map("email_verified")
  displayName    String?   @map("display_name")
  unitPreference String    @default("kg") @map("unit_preference") // CHECK ('kg','lb') added in migration
  timezone       String    @default("UTC") // IANA name
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Spec 03.1: back-reference for `exercise.owner_user_id` (Prisma requires both
  // sides of a relation). No column on `user`; purge cascades via the FK.
  customExercises Exercise[]
  // Spec 05.0: back-reference for `workout.user_id`.
  workouts Workout[]
  // Spec 07.0: back-reference for `personal_record.user_id`.
  personalRecords PersonalRecord[]
  // Spec 09: back-reference for `routine.user_id`.
  routines Routine[]

  @@index([email], map: "user_email_idx")
  @@map("user")
}

// Spec 03.1 §4 — exercise catalog. Curated rows have `ownerUserId = null` and a
// unique `catalogKey`; custom rows (Spec 03.2) set `ownerUserId` and leave
// `catalogKey` null. `isActive = false` rows are tombstones returned only in a
// sync delta (Spec 03.3; `?since=`).
model Exercise {
  id                 String       @id @db.Uuid // app-generated UUIDv7
  catalogKey         String?      @map("catalog_key") // kebab-case; null for custom rows
  ownerUserId        String?      @map("owner_user_id") @db.Uuid // null = global/curated
  owner              User?        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name               String
  modality           String // CHECK ('weight_reps', ...) — literal list in the migration
  primaryMuscleId    String?      @map("primary_muscle_id")
  primaryMuscle      MuscleGroup? @relation(fields: [primaryMuscleId], references: [id], onDelete: Restrict)
  secondaryMuscleIds String[]     @default([]) @map("secondary_muscle_ids") // muscle_group ids, authoring order
  equipmentId        String?      @map("equipment_id")
  equipment          Equipment?   @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  isActive           Boolean      @default(true) @map("is_active")
  // Spec 03.2 §4 — copy-on-write fork provenance. Always points at a global row
  // (owner_user_id IS NULL) in practice; enforced at the application layer, not
  // the DB, since forking never chains (§6).
  forkedFromExerciseId String?    @map("forked_from_exercise_id") @db.Uuid
  forkedFrom         Exercise?    @relation("ExerciseFork", fields: [forkedFromExerciseId], references: [id], onDelete: Restrict)
  forks              Exercise[]   @relation("ExerciseFork")
  // Spec 05.0: back-reference for `workout_exercise.exercise_id`.
  workoutExercises   WorkoutExercise[]
  // Spec 07.0: back-reference for `personal_record.exercise_id` (a lineage root).
  personalRecords    PersonalRecord[]
  // Spec 09: back-reference for `routine_item.exercise_id`.
  routineItems       RoutineItem[]
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Spec 03.3 §4 — commit-ordered sync stamp, set by the exercise_change_xid trigger.
  // Prisma omits Unsupported fields from its typed client; every write here is raw SQL.
  changeXid          Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("change_xid")

  @@index([ownerUserId], map: "exercise_owner_idx")
  @@index([updatedAt], map: "exercise_updated_at_idx")
  @@index([changeXid], map: "exercise_change_xid_idx")
  @@map("exercise")
}

// Reference table — natural-code PK (`chest`, `lats`). Seed-only; codes are
// immutable once shipped (Spec 03.1 D3 / §6.3).
model MuscleGroup {
  id           String     @id // natural code
  name         String
  displayOrder Int        @default(0) @map("display_order") @db.SmallInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  exercises    Exercise[]

  @@map("muscle_group")
}

// Reference table — natural-code PK (`barbell`, `dumbbell`). Seed-only; immutable.
model Equipment {
  id           String     @id // natural code
  name         String
  displayOrder Int        @default(0) @map("display_order") @db.SmallInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  exercises    Exercise[]

  @@map("equipment")
}

// Spec 05.0 §4 — workout session lifecycle. Hand-authored SQL owns the
// partial unique index, the two CHECKs and the deferrable constraint; these
// models carry the client shape only.
model Workout {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String?
  notes              String?
  startedAt          DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(6)
  localDate          DateTime  @map("local_date") @db.Date
  tzOffsetMinutes    Int       @map("tz_offset_minutes") @db.SmallInt
  clientGeneratedId  String    @map("client_generated_id") @db.Uuid
  source             String    @default("manual")
  // Spec 09 §4: set at start-from-routine; the FK is ON DELETE SET NULL, the snapshot survives.
  routineId           String?   @map("routine_id") @db.Uuid
  routine             Routine?  @relation(fields: [routineId], references: [id], onDelete: SetNull)
  routineNameSnapshot String?   @map("routine_name_snapshot")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  exercises          WorkoutExercise[]
  // Spec 07.0: back-reference for `personal_record.workout_id`.
  personalRecords    PersonalRecord[]

  @@unique([userId, clientGeneratedId], map: "workout_user_client_id_key")
  @@index([userId, startedAt(sort: Desc)], map: "workout_user_started_idx")
  @@map("workout")
}

model WorkoutExercise {
  id                   String   @id @db.Uuid
  workoutId            String   @map("workout_id") @db.Uuid
  workout              Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  position             Int      @db.SmallInt
  exerciseId           String   @map("exercise_id") @db.Uuid
  exercise             Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseNameSnapshot String   @map("exercise_name_snapshot")
  modalitySnapshot     String   @map("modality_snapshot")
  notes                String?
  // Spec 09 §4: target snapshots copied from the routine item (D1) and the live superset group (D10).
  supersetGroup        Int?     @map("superset_group") @db.SmallInt
  targetSets           Int?     @map("target_sets") @db.SmallInt
  targetRepsLow        Int?     @map("target_reps_low") @db.SmallInt
  targetRepsHigh       Int?     @map("target_reps_high") @db.SmallInt
  targetRpe            Int?     @map("target_rpe") @db.SmallInt
  restSeconds          Int?     @map("rest_seconds") @db.SmallInt
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  sets                 SetEntry[]

  @@unique([workoutId, position], map: "workout_exercise_position_key")
  @@index([exerciseId], map: "workout_exercise_exercise_idx")
  @@map("workout_exercise")
}

// Spec 09 §4 — hand-authored migration 0009 carries the CHECKs, the
// (user_id, lower(name)) expression index and ON DELETE SET NULL; these
// models are the client shape only (every repository write is raw SQL).
model Routine {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  items     RoutineItem[]
  workouts  Workout[]

  @@map("routine")
}

model RoutineItem {
  id             String   @id @db.Uuid
  routineId      String   @map("routine_id") @db.Uuid
  routine        Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  position       Int      @db.SmallInt
  exerciseId     String   @map("exercise_id") @db.Uuid
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  targetSets     Int?     @map("target_sets") @db.SmallInt
  targetRepsLow  Int?     @map("target_reps_low") @db.SmallInt
  targetRepsHigh Int?     @map("target_reps_high") @db.SmallInt
  targetRpe      Int?     @map("target_rpe") @db.SmallInt // tenths (D5)
  restSeconds    Int?     @map("rest_seconds") @db.SmallInt
  supersetGroup  Int?     @map("superset_group") @db.SmallInt
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([routineId, position], map: "routine_item_routine_position_key")
  @@index([exerciseId], map: "routine_item_exercise_idx")
  @@map("routine_item")
}

model SetEntry {
  id                String          @id @db.Uuid
  workoutExerciseId String          @map("workout_exercise_id") @db.Uuid
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int             @map("set_number") @db.SmallInt
  setType           String          @default("working") @map("set_type")
  reps              Int?            @db.SmallInt
  weight            Decimal?        @db.Decimal(7, 3)
  weightUnit        String?         @map("weight_unit")
  /// GENERATED ALWAYS AS ... STORED (0006). Read-only by convention; never written by the app.
  weightKg          Decimal?        @map("weight_kg") @db.Decimal(7, 3)
  distance          Decimal?        @db.Decimal(9, 3)
  distanceUnit      String?         @map("distance_unit")
  /// GENERATED ALWAYS AS ... STORED (0006). Read-only by convention; never written by the app.
  distanceM         Decimal?        @map("distance_m") @db.Decimal(9, 3)
  durationS         Int?            @map("duration_s")
  rpe               Decimal?        @db.Decimal(3, 1)
  isComplete        Boolean         @default(false) @map("is_complete")
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// Optional create idempotency key (0007); NULL when the create sent none.
  clientGeneratedId String?         @map("client_generated_id") @db.Uuid
  // Spec 07.0: back-reference for `personal_record.source_set_entry_id`.
  personalRecords   PersonalRecord[]

  @@unique([workoutExerciseId, setNumber], map: "set_entry_workout_exercise_number_key")
  @@unique([workoutExerciseId, clientGeneratedId], map: "set_entry_workout_exercise_client_id_key")
  @@map("set_entry")
}

// Spec 07.0 §4 — a rebuildable cache of personal records. `exerciseId` is the
// LINEAGE ROOT (COALESCE(forked_from_exercise_id, id)), not necessarily the
// exercise logged. CHECKs live in the hand-authored migration (drift-guarded).
model PersonalRecord {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId       String    @map("exercise_id") @db.Uuid
  exercise         Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  recordType       String    @map("record_type")
  value            Decimal   @db.Decimal(12, 3)
  unit             String
  previousValue    Decimal?  @map("previous_value") @db.Decimal(12, 3)
  sourceSetEntryId String    @map("source_set_entry_id") @db.Uuid
  sourceSetEntry   SetEntry  @relation(fields: [sourceSetEntryId], references: [id], onDelete: Cascade)
  workoutId        String    @map("workout_id") @db.Uuid
  workout          Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  achievedAt       DateTime  @map("achieved_at") @db.Timestamptz(6)
  localDate        DateTime  @map("local_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, exerciseId, recordType], map: "personal_record_user_exercise_type_key")
  @@index([workoutId], map: "personal_record_workout_idx")
  @@index([sourceSetEntryId], map: "personal_record_source_set_idx")
  @@map("personal_record")
}
