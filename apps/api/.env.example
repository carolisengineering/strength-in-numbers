# Spec 01 §8 — copy to apps/api/.env for local dev (`pnpm --filter @sin/api dev`
# auto-loads it). No real secrets in the repo.

NODE_ENV=development
PORT=8080

# Local Postgres from `docker compose up -d db`. sslmode/connection_limit are
# backfilled by the app if absent (Spec 01 §8 Q9).
DATABASE_URL=postgresql://sin:sin@localhost:5433/sin?sslmode=disable

# Local IdP stand-in: `pnpm --filter @sin/api dev:idp` (http allowed outside prod).
# For a real tenant use https://si-staging.us.auth0.com/ (Spec 01 Q1).
AUTH0_ISSUER=http://localhost:9999/
AUTH0_AUDIENCE=https://api.strengthinnumbers.app
AUTH0_CLAIM_NAMESPACE=https://strengthinnumbers.app/

# CORS allowlist — exact origins, comma-separated, no wildcard (Spec 01 §5.5).
WEB_ORIGIN=http://localhost:5173

# Optional
LOG_LEVEL=debug
# Spec 13.0 — telemetry. Unset = off. For the local stack
# (`docker compose -f docker-compose.observability.yml up -d`, Grafana on :3001):
# OTEL_METRICS_EXPORTER=prometheus            # Prometheus pulls :9464/metrics
# OTEL_TRACES_EXPORTER=otlp                   # pushed to local Tempo
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
SERVICE_NAME=si-api

# Spec 19.0: comma-separated user ids the Hevy routes answer for (everyone else gets 404). Unset = off for everyone.
# HEVY_ENABLED_USER_IDS=
