# Spec 01 §8 — copy to .env for local dev. No real secrets in the repo.

NODE_ENV=development
PORT=3000

# Local: the docker-compose Postgres. sslmode/connection_limit are backfilled by
# the app if absent (Spec 01 §8 Q9).
DATABASE_URL=postgresql://sin:sin@localhost:5432/sin?sslmode=disable

# Auth0 — local dev points at the si-staging tenant (Spec 01 Q1).
AUTH0_ISSUER=https://si-staging.us.auth0.com/
AUTH0_AUDIENCE=https://api.strengthinnumbers.app
AUTH0_CLAIM_NAMESPACE=https://strengthinnumbers.app/

# CORS allowlist — exact origins, comma-separated, no wildcard (Spec 01 §5.5).
WEB_ORIGIN=http://localhost:5173

# Optional
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=
SERVICE_NAME=si-api
