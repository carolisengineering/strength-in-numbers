{
  "name": "@sin/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:idp": "tsx scripts/dev-idp.ts",
    "start": "node dist/main.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed:catalog": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "records:rebuild": "tsx --env-file-if-exists=.env scripts/rebuild-records.ts",
    "account:purge": "tsx --env-file-if-exists=.env scripts/purge-accounts.ts",
    "bench:finish": "tsx scripts/bench-finish.ts",
    "bench:history": "tsx scripts/bench-history.ts",
    "bench:progress": "tsx scripts/bench-progress.ts",
    "openapi:emit": "tsx scripts/emit-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/otel": "0.21.3",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-prometheus": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-runtime-node": "0.36.1",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@prisma/client": "^6.2.1",
    "@prisma/instrumentation": "6.19.3",
    "@sin/core": "workspace:*",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "^5.9.6",
    "pino": "^9.6.0",
    "prisma": "^6.2.1",
    "uuidv7": "^1.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.4.1",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "yaml": "2.9.0"
  }
}
