# Spec 21.1 §6.8 — copy to apps/api/.env.owner. LOCAL ONLY, no real secrets in the repo. Loaded by the maintenance
# commands (db:migrate:*, migrate:dev, db:app-role, seed:catalog, records:rebuild, account:purge), never by `dev`: the
# API refuses to start with OWNER_DATABASE_URL in its environment.
OWNER_DATABASE_URL=postgresql://sin:sin@localhost:5433/sin?sslmode=disable

# The password db:app-role gives sin_app; it matches DATABASE_URL in apps/api/.env.example.
APP_ROLE_PASSWORD=sin_app_local
