# apps/web build-time configuration (Spec 04.0 §8).
#
# Vite exposes ONLY `VITE_`-prefixed vars to client code, and they are baked into
# the bundle at build time. None of these are secrets: the Auth0 domain, SPA
# client id and API audience are all public by design (they appear in the
# /authorize redirect URL). A PKCE public client has no client secret — never put
# a client secret or an access token in this file or in any `.env*`.
#
# Local dev: copy to `apps/web/.env.local` (git-ignored) and fill in real values.
# Staging / production: set as Render static-site environment variables.

# Auth0 tenant domain — host only, no scheme, no trailing slash. (required)
VITE_AUTH0_DOMAIN=dev-gncuqvfir0wv0t4l.us.auth0.com

# Auth0 SPA application client id — public, environment-specific. (required)
VITE_AUTH0_CLIENT_ID=replace-with-spa-client-id

# Auth0 API audience — an http(s) URL identifier; must equal the API's
# AUTH0_AUDIENCE (Spec 01). (required)
VITE_AUTH0_AUDIENCE=https://api.strengthinnumbers.app

# Base URL of the @sin/api backend — no trailing slash; the client appends
# `/v1/...`. (required)
VITE_API_BASE_URL=http://localhost:8080

# Deploy environment: local | staging | production. Gates dev-hard vs prod-warn
# response-schema validation (§6.4). Optional — defaults to "local".
VITE_APP_ENV=local
