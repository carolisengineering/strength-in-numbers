{
  "uid": "sin-api-overview",
  "title": "si-api — overview",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": {} },
      {
        "name": "cpu_limit", "label": "CPU limit (cores)", "type": "textbox", "query": "0.1",
        "current": { "text": "0.1", "value": "0.1" },
        "description": "CPU allowance: 0.1 on Render free, 1 on prod Cloud Run"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Restarts",
        "enable": true,
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "changes(sin_process_start_time_seconds[2m]) > 0",
        "iconColor": "orange"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries", "title": "Request rate by route", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{http_route}}" }]
    },
    {
      "type": "timeseries", "title": "5xx ratio", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "(sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "5xx / all" }]
    },
    {
      "type": "timeseries", "title": "Latency p50 / p95 / p99", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries", "title": "p95 latency by route", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{http_route}}" }]
    },
    {
      "type": "timeseries", "title": "Event-loop delay p99", "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "max(nodejs_eventloop_delay_p99_seconds)", "legendFormat": "p99" }]
    },
    {
      "type": "timeseries", "title": "Heap used", "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(v8js_memory_heap_used_bytes)", "legendFormat": "heap used" }]
    },
    {
      "type": "timeseries", "title": "GC time per second", "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (v8js_gc_type) (rate(v8js_gc_duration_seconds_sum[$__rate_interval]))", "legendFormat": "{{v8js_gc_type}}" }]
    },
    {
      "type": "timeseries", "title": "CPU cores in use", "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "description": "API process CPU in cores (1 = one full core), stacked user + system. The dashed line is the cpu_limit variable: 0.1 on Render free, 1 on prod Cloud Run.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "stacking": { "mode": "normal", "group": "A" }, "fillOpacity": 20 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "limit" },
            "properties": [
              { "id": "custom.stacking", "value": { "mode": "none", "group": "A" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        { "refId": "A", "expr": "sum by (cpu_mode) (rate(sin_process_cpu_seconds_total[$__rate_interval]))", "legendFormat": "{{cpu_mode}}" },
        { "refId": "B", "expr": "vector($cpu_limit)", "legendFormat": "limit" }
      ]
    },
    {
      "type": "timeseries", "title": "CPU throttled", "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "description": "Fraction of each second the container was held back by its CPU quota (cgroup v2). No data = this host does not report throttling.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(sin_container_cpu_throttled_seconds_total[$__rate_interval])", "legendFormat": "throttled" }]
    },
    {
      "type": "timeseries", "title": "DB connections in use vs limit", "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "description": "Instantaneous: one point per export, so a spike between exports is not seen. The limit is the pool's connection_limit.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(sin_db_pool_connections{state=\"busy\"})", "legendFormat": "in use" },
        { "refId": "B", "expr": "max(sin_db_pool_limit)", "legendFormat": "limit" }
      ]
    },
    {
      "type": "timeseries", "title": "DB queries waiting for a connection", "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "description": "Instantaneous, like the connections panel. Mean pool wait per query is counter-based and does not miss spikes.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "max(sin_db_pool_waiting)", "legendFormat": "waiting" }]
    },
    {
      "type": "timeseries", "title": "Mean pool wait per query", "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "description": "Average time a query waited for a free database connection, over the rate interval.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(sin_db_pool_wait_seconds_total[$__rate_interval]) / clamp_min(rate(sin_db_pool_waits_total[$__rate_interval]), 1e-9)", "legendFormat": "mean wait" }]
    }
  ]
}
