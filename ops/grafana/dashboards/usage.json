{
  "uid": "sin-usage",
  "title": "si-api — usage",
  "schemaVersion": 39,
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [{ "name": "datasource", "type": "datasource", "query": "prometheus", "current": {} }]
  },
  "panels": [
    {
      "type": "timeseries", "title": "Workouts started / finished (per hour)", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(sin_workouts_started_total[1h]))", "legendFormat": "started" },
        { "refId": "B", "expr": "sum(increase(sin_workouts_finished_total[1h]))", "legendFormat": "finished" }
      ]
    },
    {
      "type": "timeseries", "title": "Sets logged by modality (per hour)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "sum by (modality) (increase(sin_sets_logged_total[1h]))", "legendFormat": "{{modality}}" }]
    },
    {
      "type": "stat", "title": "Sets logged (range)", "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "sum(increase(sin_sets_logged_total[$__range]))" }]
    }
  ]
}
