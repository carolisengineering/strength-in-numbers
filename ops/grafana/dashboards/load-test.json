{
  "uid": "sin-load-test",
  "title": "si-api — load test",
  "description": "Spec 16: k6's load next to the API's own health. Open it at a run's annotation window (runbook load-testing.md).",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "cpu_limit",
        "label": "CPU limit (cores)",
        "type": "textbox",
        "query": "0.1",
        "current": {
          "text": "0.1",
          "value": "0.1"
        },
        "description": "CPU allowance: 0.1 on Render free, 1 on prod Cloud Run"
      },
      {
        "name": "target",
        "label": "Target",
        "type": "custom",
        "query": "staging,prod,local",
        "current": {
          "text": "staging",
          "value": "staging"
        },
        "options": [
          { "text": "staging", "value": "staging", "selected": true },
          { "text": "prod", "value": "prod", "selected": false },
          { "text": "local", "value": "local", "selected": false }
        ],
        "includeAll": false,
        "multi": false,
        "description": "Which load-test target the k6 panels show (minor 592); the API panels are the API's own metrics"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Load test runs",
        "enable": true,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "loadtest"
          ],
          "matchAny": false,
          "limit": 100
        },
        "iconColor": "purple"
      },
      {
        "name": "Restarts",
        "enable": true,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "changes(sin_process_start_time_seconds[2m]) > 0",
        "iconColor": "orange"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Load (k6, from the laptop)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Simulated lifters",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "description": "Lifters k6 is running right now: one per account, stepping up through the gym ladder.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_vus{target=\"$target\"})",
          "legendFormat": "lifters"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests per second by request",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "description": "Requests k6 sent, by request template (never by URL).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(k6_http_reqs_total{target=\"$target\"}[$__rate_interval]))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Set-save p95 by step, against the 2 s line",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "description": "Saving a set, 95th percentile as k6 sees it, per step, over answered saves in the step's measured part (not the ramp). Above the dashed 2 s line the step fails (X). Timeouts show in the 5xx panel, not here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2 s line"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (step) (k6_http_req_duration_p95{name=\"set_save\", phase=\"measure\", status=~\"2..\", target=\"$target\"})",
          "legendFormat": "step {{step}}"
        },
        {
          "refId": "B",
          "expr": "vector(2)",
          "legendFormat": "2 s line"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx share (k6)",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "description": "Share of each step's requests answered 5xx or not at all (status 0), pooled over every request as the tool judges it. Above 1% the step fails (X).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "1% line"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (step) (k6_http_reqs_total{phase=\"measure\", status=~\"5..|0\", target=\"$target\"}) or 0 * sum by (step) (k6_http_reqs_total{phase=\"measure\", target=\"$target\"})) / sum by (step) (k6_http_reqs_total{phase=\"measure\", target=\"$target\"})",
          "legendFormat": "step {{step}}"
        },
        {
          "refId": "B",
          "expr": "vector(0.01)",
          "legendFormat": "1% line"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "429s (k6)",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "description": "Requests the API rate-limited during each step's measured part. Any 429 fails the step (X).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (step) (increase(k6_rate_limited_total{phase=\"measure\", target=\"$target\"}[$__rate_interval]))",
          "legendFormat": "step {{step}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Server health (si-api)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx ratio",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "5xx / all"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event-loop delay p99",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nodejs_eventloop_delay_p99_seconds)",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap used",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(v8js_memory_heap_used_bytes)",
          "legendFormat": "heap used"
        }
      ]
    },
    {
      "type": "row",
      "title": "CPU and database pool (Spec 13.3)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU cores in use",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "description": "API process CPU in cores (1 = one full core), stacked user + system. The dashed line is the cpu_limit variable: 0.1 on Render free, 1 on prod Cloud Run.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 20
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "limit"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cpu_mode) (rate(sin_process_cpu_seconds_total[$__rate_interval]))",
          "legendFormat": "{{cpu_mode}}"
        },
        {
          "refId": "B",
          "expr": "vector($cpu_limit)",
          "legendFormat": "limit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB connections in use vs limit",
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "description": "Instantaneous: one point per export, so a spike between exports is not seen. The limit is the pool's connection_limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sin_db_pool_connections{state=\"busy\"})",
          "legendFormat": "in use"
        },
        {
          "refId": "B",
          "expr": "max(sin_db_pool_limit)",
          "legendFormat": "limit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB queries waiting for a connection",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "description": "Instantaneous, like the connections panel. Mean pool wait per query is counter-based and does not miss spikes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sin_db_pool_waiting)",
          "legendFormat": "waiting"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mean pool wait per query",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "description": "Average time a query waited for a free database connection, over the rate interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sin_db_pool_wait_seconds_total[$__rate_interval]) / clamp_min(rate(sin_db_pool_waits_total[$__rate_interval]), 1e-9)",
          "legendFormat": "mean wait"
        }
      ]
    }
  ]
}
